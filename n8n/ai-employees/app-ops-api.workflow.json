    "jsCode": "const b = $json.body || {};\nlet ok = false;\nif (b.token) {\n  try {\n    const r = await this.helpers.httpRequest({ method: 'POST', url: 'https://snrsfpprlynixotjipmo.supabase.co/rest/v1/rpc/app_is_owner',\n      headers: { apikey: 'sb_publishable_Q9zcnd6bo1cM4VDRysyjbA_XBr6lhds', Authorization: 'Bearer ' + b.token, 'Content-Type': 'application/json' }, body: {}, json: true });\n    ok = r === true || r === 'true';\n  } catch (e) { ok = false; }\n}\nconst decision = ['approved', 'rejected', 'done'].includes(b.decision) ? b.decision : '';\nreturn [{ json: { ok, action: String(b.action || 'list'), id: String(b.id || ''), decision } }];"
