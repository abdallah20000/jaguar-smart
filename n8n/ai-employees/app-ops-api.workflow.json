   "parameters": {
    "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.id);\nconst since = Date.now() - 4 * 86400000;\nconst items = rows.filter(r => r.status === 'pending' || new Date(r.createdAt).getTime() >= since).map(r => ({\n  id: r.id, kind: r.kind, business: r.business, agent: r.agent, title: r.title, body: r.body, link: r.link,\n  status: r.status, review: r.review, day: r.day, at: r.createdAt, decided_at: r.decided_at }));\nconst today = DateTime.now().setZone('Africa/Cairo').toFormat('yyyy-MM-dd');\nconst t = items.filter(r => r.day === today);\nreturn [{ json: { items, stats: { pending: items.filter(r => r.status === 'pending').length, today: t.length, approved_today: t.filter(r => r.status === 'approved').length } } }];"
   }
